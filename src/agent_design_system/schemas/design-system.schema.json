{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adsf:schema:design-system:0.1.0",
  "title": "Agent Design System Format",
  "description": "A deterministic, agent-readable design-system contract.",
  "type": "object",
  "required": ["format", "version", "name", "description", "tokens", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "adsf" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "tokens": { "$ref": "#/$defs/tokenGroup" },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "metadata": { "type": "object" },
    "extensions": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "tokenGroup": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/token" },
          { "$ref": "#/$defs/tokenGroup" }
        ]
      }
    },
    "token": {
      "type": "object",
      "required": ["$type", "$value", "$description"],
      "properties": {
        "$type": {
          "enum": ["color", "dimension", "number", "fontFamily", "fontWeight", "duration", "cubicBezier", "string", "boolean"]
        },
        "$value": {},
        "$description": { "type": "string", "minLength": 1 },
        "$extensions": { "type": "object" }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["id", "description", "rationale", "selector", "assert", "severity", "decision"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "description": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "selector": { "type": "string", "pattern": "^\\$(\\.|$)" },
        "assert": { "$ref": "#/$defs/assertion" },
        "severity": { "enum": ["info", "warning", "error"] },
        "decision": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/branch" }
        }
      },
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "required": ["operator"],
      "properties": {
        "operator": { "enum": ["token-reference", "enum", "equals", "type", "pattern", "property-exists"] },
        "category": { "type": "string" },
        "values": { "type": "array" },
        "value": {}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "operator": { "const": "enum" } }, "required": ["operator"] },
          "then": { "required": ["values"] }
        },
        {
          "if": { "properties": { "operator": { "enum": ["equals", "type", "pattern", "property-exists"] } }, "required": ["operator"] },
          "then": { "required": ["value"] }
        },
        {
          "if": { "properties": { "operator": { "const": "type" } }, "required": ["operator"] },
          "then": {
            "properties": {
              "value": { "enum": ["string", "number", "integer", "boolean", "object", "array", "null"] }
            }
          }
        },
        {
          "if": { "properties": { "operator": { "const": "property-exists" } }, "required": ["operator"] },
          "then": { "properties": { "value": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "branch": {
      "type": "object",
      "required": ["when", "action"],
      "properties": {
        "when": { "$ref": "#/$defs/condition" },
        "action": { "$ref": "#/$defs/action" }
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "required": ["operator"],
      "properties": {
        "operator": { "enum": ["always", "value-type", "matches", "coercible"] },
        "value": {},
        "strategy": { "enum": ["nearest-token", "replace"] },
        "category": { "type": "string" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "operator": { "const": "value-type" } }, "required": ["operator"] },
          "then": {
            "required": ["value"],
            "properties": {
              "value": { "enum": ["string", "number", "integer", "boolean", "object", "array", "null"] }
            }
          }
        },
        {
          "if": { "properties": { "operator": { "const": "matches" } }, "required": ["operator"] },
          "then": { "required": ["value"], "properties": { "value": { "type": "string" } } }
        },
        {
          "if": { "properties": { "operator": { "const": "coercible" } }, "required": ["operator"] },
          "then": { "required": ["strategy"] }
        },
        {
          "if": {
            "properties": {
              "operator": { "const": "coercible" },
              "strategy": { "const": "nearest-token" }
            },
            "required": ["operator", "strategy"]
          },
          "then": { "required": ["category"] }
        },
        {
          "if": {
            "properties": {
              "operator": { "const": "coercible" },
              "strategy": { "const": "replace" }
            },
            "required": ["operator", "strategy"]
          },
          "then": { "required": ["value"] }
        }
      ]
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["report", "coerce", "reject", "ignore"] },
        "strategy": { "enum": ["nearest-token", "replace"] },
        "category": { "type": "string" },
        "value": {},
        "message": { "type": "string" },
        "rationale": { "type": "string" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "coerce" } }, "required": ["type"] },
          "then": { "required": ["strategy"] }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "coerce" },
              "strategy": { "const": "nearest-token" }
            },
            "required": ["type", "strategy"]
          },
          "then": { "required": ["category"] }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "coerce" },
              "strategy": { "const": "replace" }
            },
            "required": ["type", "strategy"]
          },
          "then": { "required": ["value"] }
        }
      ]
    }
  }
}
