{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adsf:schema:css-policy:0.1.0",
  "title": "ADSF authored CSS policy",
  "type": "object",
  "required": ["version", "bindings", "properties", "unrestricted_properties"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "0.1.0" },
    "bindings": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-zA-Z0-9_-]+(\\.[a-zA-Z0-9_-]+)*$" },
      "additionalProperties": { "type": "string", "pattern": "^--[a-zA-Z_][a-zA-Z0-9_-]*$" }
    },
    "properties": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^(?!all$)[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["tokens"],
        "additionalProperties": false,
        "properties": {
          "tokens": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "max_values": { "type": "integer", "minimum": 1, "maximum": 4 },
          "literals": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "unrestricted_properties": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?!all$)[a-z][a-z0-9-]*$" }
    }
  }
}
